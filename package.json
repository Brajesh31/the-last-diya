{
  "name": "the-last-diya",
  "private": true,
  "version": "0.1.0",
  "description": "The Last Diya, a cooperative multiplayer web adventure.",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -ws --if-present",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:multiplayer": "node scripts/multiplayer-smoke-test.mjs",
    "test:multiplayer:load": "node scripts/multiplayer-load-test.mjs",
    "test:vertical-slice": "node scripts/vertical-slice-quest-test.mjs",
    "test:collision": "node --import tsx scripts/player-collision-test.mjs",
    "test:browser:multiplayer": "node scripts/browser-multiplayer-test.mjs",
    "test:server-hardening": "node scripts/server-hardening-test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
